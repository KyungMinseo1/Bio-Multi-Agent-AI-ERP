# Copy to .env and supply secrets; never commit .env.
POSTGRES_DB=bioerp
POSTGRES_USER=bioerp
POSTGRES_PASSWORD=
SESSION_SECRET=
INITIAL_APPROVER_EMAIL=
INITIAL_APPROVER_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Optional operator account
INITIAL_OPERATOR_EMAIL=
INITIAL_OPERATOR_PASSWORD=
# Reproducible prototype calendar; remove for current-date planning.
PLANNING_AS_OF=2026-10-24
LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=60
# Full four-AI parallel passes before Admin integration; integer 1-5, default 1.
LLM_REVIEW_ROUNDS=1
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional OpenAI Responses endpoint override.
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
# Generic OpenAI-compatible Chat Completions server; URL AND served model ID required.
# Set LLM_PROVIDER=openai_compatible; base URL must end in /v1.
# Server/model must support strict response_format=json_schema structured output.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
# vLLM is a separate server, not loaded inside this application.
# Example server command: vllm serve <model-id> --tensor-parallel-size 2
# Set LLM_PROVIDER=vllm; URL ending in /v1 AND served model ID required.
# VLLM_API_KEY and OPENAI_COMPATIBLE_API_KEY are optional for unauthenticated servers.
# Example base URL: http://inference-host:8000/v1 (reachable from API and worker).
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=
FDA_API_KEY=
# Local development only: DATABASE_URL=sqlite:///./bioerp.db
# Optional JSON mapping for purchasing, inventory_planning, quality, finance, admin.
LLM_ROLE_MAPPING={}
