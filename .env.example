PLANNING_AS_OF=2026-10-24
LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=
FDA_API_KEY=
# Local development only: DATABASE_URL=sqlite:///./bioerp.db
# Optional JSON role mapping, as documented in README.
LLM_ROLE_MAPPING={}
